# Python .gitignore for the Quiz Game project.

# --- Local virtual environment (see README, "Set up") ---
.venv/
venv/
env/
ENV/

# --- Personal secrets: tokens for the git host. Never commit. ---
.env
.env.*
!.env.example

# --- Byte-compiled files and caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.hypothesis/

# --- Test and coverage output ---
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# --- Packaging and build output ---
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
wheels/
share/python-wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# --- Source documentation generated by Doxygen (README, "Build the source documentation") ---
docs/doxygen/

# --- Editors and operating systems ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter and misc ---
.ipynb_checkpoints/
*.log
